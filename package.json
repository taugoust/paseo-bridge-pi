{
  "name": "paseo-bridge-pi",
  "version": "0.1.0",
  "description": "Surface terminal-started pi TUI sessions in Paseo, live and steerable.",
  "type": "module",
  "license": "MIT",
  "author": "Caelan <git@caesay.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/taugoust/paseo-bridge-pi"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extension"
    ]
  },
  "files": [
    "shim",
    "extension",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "dev-install": "node scripts/install.js",
    "dev-uninstall": "node scripts/uninstall.js",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:plugin": "node --experimental-strip-types --test plugin/test/*.test.ts plugin/test/compiled-*.test.mjs",
    "typecheck": "tsc --noEmit --module nodenext --moduleResolution nodenext --target es2022 --skipLibCheck extension/index.ts extension/pi-ai-compat.d.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typescript": "^5.9.3"
  }
}
